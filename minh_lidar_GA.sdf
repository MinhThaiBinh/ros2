<?xml version="1.0" ?>

<sdf version="1.6">

  <model name="robot_minh" xmlns:gz="http://gazebosim.org/schema">

    <pose>0 0 0.025 0 0 0</pose>



    <link name='khung_xe'>

      <pose>0 0 0.025 0 0 0</pose>

      <inertial>

        <mass>1.0</mass>

        <inertia>

          <ixx>0.0016</ixx> <ixy>0</ixy> <ixz>0</ixz>

          <iyy>0.0054</iyy> <iyz>0</iyz> <izz>0.0066</izz>

        </inertia>

      </inertial>

      <visual name='hien_thi'>

        <geometry>

          <box><size>0.25 0.13 0.05</size></box>

        </geometry>

        <material>
          <ambient>0.0 1.0 0.0 1</ambient>
          <diffuse>0.0 1.0 0.0 1</diffuse>
        </material>

      </visual>

      <collision name='va_cham'>

        <geometry>

          <box><size>0.25 0.13 0.05</size></box>

        </geometry>

      </collision>

      <!-- GIÚP HIỂN THỊ HỆ TRỤC TỌA ĐỘ CỤC BỘ (Manual Debug) -->
      <!-- Trục X (Forward) - Màu Đỏ (Dài 0.3m) -->
      <visual name='axis_x'>
        <pose>0.15 0 0 0 1.5707 0</pose>
        <geometry><cylinder><radius>0.005</radius><length>0.3</length></cylinder></geometry>
        <material>
          <ambient>1 0 0 1</ambient>
          <diffuse>1 0 0 1</diffuse>
          <emissive>1 0 0 1</emissive>
        </material>
      </visual>
      <!-- Trục Y (Left) - Màu Xanh Lá (Dài 0.3m) -->
      <visual name='axis_y'>
        <pose>0 0.15 0 1.5707 0 0</pose>
        <geometry><cylinder><radius>0.005</radius><length>0.3</length></cylinder></geometry>
        <material>
          <ambient>0 1 0 1</ambient>
          <diffuse>0 1 0 1</diffuse>
          <emissive>0 1 0 1</emissive>
        </material>
      </visual>

      <visual name="M1"><pose>-0.085 0.03 0.026 0 0 0</pose><geometry><box><size>0.005 0.04 0.002</size></box></geometry><material><diffuse>1 1 0 1</diffuse></material></visual>

      <visual name="M2"><pose>-0.065 0.03 0.026 0 0 0</pose><geometry><box><size>0.005 0.04 0.002</size></box></geometry><material><diffuse>1 1 0 1</diffuse></material></visual>

      <visual name="M3"><pose>-0.079 0.034 0.026 0 0 -0.6</pose><geometry><box><size>0.022 0.005 0.002</size></box></geometry><material><diffuse>1 1 0 1</diffuse></material></visual>

      <visual name="M4"><pose>-0.071 0.034 0.026 0 0 0.6</pose><geometry><box><size>0.022 0.005 0.002</size></box></geometry><material><diffuse>1 1 0 1</diffuse></material></visual>

      <visual name="I1"><pose>-0.045 0.045 0.026 0 0 0</pose><geometry><box><size>0.02 0.005 0.002</size></box></geometry><material><diffuse>1 1 0 1</diffuse></material></visual>

      <visual name="I2"><pose>-0.045 0.03 0.026 0 0 0</pose><geometry><box><size>0.005 0.03 0.002</size></box></geometry><material><diffuse>1 1 0 1</diffuse></material></visual>

      <visual name="I3"><pose>-0.045 0.015 0.026 0 0 0</pose><geometry><box><size>0.02 0.005 0.002</size></box></geometry><material><diffuse>1 1 0 1</diffuse></material></visual>

      <visual name="N1"><pose>-0.025 0.03 0.026 0 0 0</pose><geometry><box><size>0.005 0.04 0.002</size></box></geometry><material><diffuse>1 1 0 1</diffuse></material></visual>

      <visual name="N2"><pose>-0.005 0.03 0.026 0 0 0</pose><geometry><box><size>0.005 0.04 0.002</size></box></geometry><material><diffuse>1 1 0 1</diffuse></material></visual>

      <visual name="N3"><pose>-0.015 0.03 0.026 0 0 -0.75</pose><geometry><box><size>0.03 0.005 0.002</size></box></geometry><material><diffuse>1 1 0 1</diffuse></material></visual>

      <visual name="H1"><pose>0.015 0.03 0.026 0 0 0</pose><geometry><box><size>0.005 0.04 0.002</size></box></geometry><material><diffuse>1 1 0 1</diffuse></material></visual>

      <visual name="H2"><pose>0.035 0.03 0.026 0 0 0</pose><geometry><box><size>0.005 0.04 0.002</size></box></geometry><material><diffuse>1 1 0 1</diffuse></material></visual>

      <visual name="H3"><pose>0.025 0.03 0.026 0 0 0</pose><geometry><box><size>0.02 0.005 0.002</size></box></geometry><material><diffuse>1 1 0 1</diffuse></material></visual>

    </link>



    <link name="lidar_link">

      <pose>0.08 0 0.05 0 0 0</pose>

      <inertial>

        <mass>0.17</mass>

        <inertia><ixx>0.0001</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.0001</iyy><iyz>0</iyz><izz>0.0001</izz></inertia>

      </inertial>

      <visual name="lidar_base_visual">

        <pose>0 0 0.01155 0 0 0</pose>

        <geometry><box><size>0.0556 0.0556 0.0231</size></box></geometry>

        <material><diffuse>0.1 0.1 0.1 1</diffuse></material>

      </visual>

      <visual name="lidar_top_visual">

        <pose>0 0 0.03225 0 0 0</pose>

        <geometry><cylinder><radius>0.0215</radius><length>0.0182</length></cylinder></geometry>

        <material><diffuse>0.2 0.2 0.2 1</diffuse></material>

      </visual>

      <sensor name="lidar" type="gpu_ray">
        <topic>scan</topic>
        <pose>0 0 0.0298 0 0 0</pose>

        <update_rate>1</update_rate>
        <always_on>true</always_on>
        <visualize>true</visualize>

        <ray>

          <scan>
            <horizontal>
              <samples>12</samples> // 12 rays per scan
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>6.28</max_angle>
            </horizontal>
          </scan>

          <range>
            <min>0.02</min>
            <max>3.0</max>
            <resolution>0.01</resolution>
          </range>

          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.0</stddev>
          </noise>

        </ray>

        <visualize>true</visualize>
      </sensor>

    </link>



    <joint name="lidar_joint" type="fixed">

      <parent>khung_xe</parent><child>lidar_link</child>

    </joint>



    <link name='banh_truoc_trai'>
      <pose>0.065 0.06 0 -1.5707 0 0</pose>
      <inertial><mass>0.1</mass><inertia><ixx>0.0001</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.0001</iyy><iyz>0</iyz><izz>0.0001</izz></inertia></inertial>
      <visual name='v'>
        <pose>0 0 0 1.5707 0 0</pose>
        <geometry>
          <mesh>
            <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Mecanum lift/tip/files/meshes/mecanum_wheel_left.STL</uri>
            <scale>0.0005 0.0005 0.0005</scale> 
          </mesh>
        </geometry>
        <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
      </visual>
      <collision name='c'>
        <geometry><sphere><radius>0.025</radius></sphere></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
    </link>

    <link name='banh_truoc_phai'>
      <pose>0.065 -0.06 0 -1.5707 0 0</pose>
      <inertial><mass>0.1</mass><inertia><ixx>0.0001</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.0001</iyy><iyz>0</iyz><izz>0.0001</izz></inertia></inertial>
      <visual name='v'>
        <pose>0 0 0 1.5707 0 0</pose>
        <geometry>
          <mesh>
            <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Mecanum lift/tip/files/meshes/mecanum_wheel_right.STL</uri>
            <scale>0.0005 0.0005 0.0005</scale>
          </mesh>
        </geometry>
        <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
      </visual>
      <collision name='c'>
        <geometry><sphere><radius>0.025</radius></sphere></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
    </link>

    <link name='banh_sau_trai'>
      <pose>-0.065 0.06 0 -1.5707 0 0</pose>
      <inertial><mass>0.1</mass><inertia><ixx>0.0001</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.0001</iyy><iyz>0</iyz><izz>0.0001</izz></inertia></inertial>
      <visual name='v'>
        <pose>0 0 0 1.5707 0 0</pose>
        <geometry>
          <mesh>
            <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Mecanum lift/tip/files/meshes/mecanum_wheel_right.STL</uri>
            <scale>0.0005 0.0005 0.0005</scale>
          </mesh>
        </geometry>
        <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
      </visual>
      <collision name='c'>
        <geometry><sphere><radius>0.025</radius></sphere></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
    </link>

    <link name='banh_sau_phai'>
      <pose>-0.065 -0.06 0 -1.5707 0 0</pose>
      <inertial><mass>0.1</mass><inertia><ixx>0.0001</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.0001</iyy><iyz>0</iyz><izz>0.0001</izz></inertia></inertial>
      <visual name='v'>
        <pose>0 0 0 1.5707 0 0</pose>
        <geometry>
          <mesh>
            <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Mecanum lift/tip/files/meshes/mecanum_wheel_left.STL</uri>
            <scale>0.0005 0.0005 0.0005</scale>
          </mesh>
        </geometry>
        <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
      </visual>
      <collision name='c'>
        <geometry><sphere><radius>0.025</radius></sphere></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
    </link>

    <joint name='khop_truoc_trai' type='revolute'><parent>khung_xe</parent><child>banh_truoc_trai</child><axis><xyz>0 0 1</xyz></axis></joint>
    <joint name='khop_truoc_phai' type='revolute'><parent>khung_xe</parent><child>banh_truoc_phai</child><axis><xyz>0 0 1</xyz></axis></joint>
    <joint name='khop_sau_trai' type='revolute'><parent>khung_xe</parent><child>banh_sau_trai</child><axis><xyz>0 0 1</xyz></axis></joint>
    <joint name='khop_sau_phai' type='revolute'><parent>khung_xe</parent><child>banh_sau_phai</child><axis><xyz>0 0 1</xyz></axis></joint>

    <plugin filename="gz-sim-mecanum-drive-system" name="gz::sim::systems::MecanumDrive">
      <topic>/model/GA_8_TIA/cmd_vel</topic>
      <front_left_joint>khop_truoc_trai</front_left_joint>
      <front_right_joint>khop_truoc_phai</front_right_joint>
      <back_left_joint>khop_sau_trai</back_left_joint>
      <back_right_joint>khop_sau_phai</back_right_joint>
      <wheel_separation>0.12</wheel_separation>
      <wheelbase>0.13</wheelbase>
      <wheel_radius>0.025</wheel_radius>
    </plugin>

    <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
      <topic>/model/GA_8_TIA/cmd_vel</topic>
    </plugin>
    
    <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
      <publish_link_pose>false</publish_link_pose>
      <publish_model_pose>true</publish_model_pose>
      <use_pose_vector_msg>false</use_pose_vector_msg>
      <static_publisher>false</static_publisher>
    </plugin>

  </model>

</sdf>
